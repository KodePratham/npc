# Copy to .env.local and fill in.
OPENAI_API_KEY=sk-...

# Model used to generate the intent graph and templates.
OPENAI_GEN_MODEL=gpt-6-luna

# Embedding model used for intent classification at chat time.
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIMENSIONS=512

# Minimum cosine similarity for an intent match. Below this the bot uses the fallback.
INTENT_THRESHOLD=0.45

# Bonus added to sub-intents and follow-ups of the currently active intent.
CONTEXT_BOOST=0.05

# ---------- Intent accuracy benchmark (scripts/bench) ----------
# Anthropic key for generating the customer questions.
ANTHROPIC_API_KEY=sk-ant-...
# Question writer. Model ids are passed through exactly as given.
BENCH_QGEN_MODEL=claude-haiku-5-5
# LLM contestant (gpt-6-luna with the intent catalog in the prompt) and its reasoning effort.
BENCH_LLM_MODEL=gpt-6-luna
BENCH_LLM_EFFORT=low
# Optional prices in USD per 1M tokens, used for the cost estimate in report.md.
BENCH_PRICE_LLM_INPUT=
BENCH_PRICE_LLM_CACHED_INPUT=
BENCH_PRICE_LLM_OUTPUT=
BENCH_PRICE_EMBED=

---
import { REPO_URL, SITE_NAME } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="border-t-4 border-ink bg-grass-dark text-paper">
  <div class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-6 px-6 py-12 text-xl sm:flex-row">
    <p>{SITE_NAME} is open source. &copy; {year}</p>
    <a href={REPO_URL} target="_blank" rel="noopener noreferrer" class="pixel-btn bg-paper text-[0.6rem] text-ink">
      github.com/KodePratham/npc
    </a>
  </div>
</footer>
